<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- เรียกใช้ Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- *** เพิ่มบรรทัดนี้เพื่อเรียกใช้ไอคอน (แก้ปัญหาไอคอนหาย) *** -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        body { 
            background-color: #fdfdfd; 
            font-family: 'Prompt', sans-serif; 
            overflow-x: hidden; 
        }
        
        .content-wrapper { 
            padding: 40px; 
            height: 100vh; 
            display: flex; 
            flex-direction: column; 
            overflow: hidden; 
            position: relative;
        }

        /* ตกแต่งกล่องข้อความให้ดูเหมือนแผ่นกระดาษ */
        .info-card {
            background-color: #ffffff;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            padding: 45px 50px;
            margin-bottom: 25px;
            position: relative;
            z-index: 2; /* ให้อยู่เหนือรูปภาพ */
            border-radius: 4px;
            /* สร้างลวดลาย Texture บางๆ คล้ายกระดาษ */
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100' height='100' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
        }

        /* รูปโปรไฟล์วงกลมด้านซ้ายบน */
        .profile-small {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            object-fit: cover;
            object-position: top;
            border: 4px solid #22499c; 
        }

        .text-black { color: #000; }
        .text-spacing { line-height: 1.8; }

        /* -------------------------------------
           รูปภาพผู้ดูแลระบบ (ฝั่งขวา แบบไม่มีแอนิเมชัน)
           ------------------------------------- */
        .admin-hero-img {
            max-width: 100%;
            height: 10000px;
            max-height: 90vh; /* จำกัดความสูงไม่ให้ล้นจอ */
            position: absolute;
            bottom: -20px; /* ยึดติดขอบล่าง */
            right: 5%; /* ขยับจากขอบขวา */
            z-index: 1;
            /* ลบแอนิเมชันออก รูปจะแสดงผลทันที */
            opacity: 1; 
        }
    </style>
</head>
<body class="d-flex">

    <!-- ดึง Sidebar เมนูด้านซ้ายมาแสดง -->
    <%- include('partials/navbar') %>

    <!-- พื้นที่เนื้อหาหลัก -->
    <div class="content-wrapper flex-grow-1">
        
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-2" style="position: relative; z-index: 3;">
            <div>
                <h3 class="fw-bold text-dark mb-0">ผู้ดูแลระบบ</h3>
                <p class="text-muted small mt-1">ข้อมูลผู้พัฒนาระบบ</p>
            </div>
        </div>

        <div class="row flex-grow-1 align-items-center">
            
            <!-- ฝั่งซ้าย: ข้อมูลผู้ดูแลระบบ -->
            <div class="col-lg-7 col-xl-6 ms-lg-5">
                
                <!-- กล่องที่ 1: ข้อมูลส่วนตัว -->
                <div class="card info-card text-spacing">
                    <div class="d-flex align-items-center mb-4">
                        <!-- รูปโปรไฟล์วงกลมในการ์ด -->
                        <img src="/images/Administrator.jpg" alt="Profile" class="profile-small me-4 shadow-sm">
                        <div>
                            <h4 class="fw-bold text-black mb-2">นายเอกวัฒน์ เจริญฤทธิ์</h4>
                            <h5 class="fw-bold text-black mb-1">เกิด 23/กันยายน/2550</h5>
                            <h5 class="fw-bold text-black">อายุ 18</h5>
                        </div>
                    </div>
                    <div class="text-center mt-4">
                        <h5 class="fw-bold text-black mb-3">สถาบัน วิทยาลัยเทคนิคภูเก็ต</h5>
                        <h5 class="fw-bold text-black">แผนก เทคโนโลยีสารสนเทศ</h5>
                    </div>
                </div>

                <!-- กล่องที่ 2: ความสามารถ -->
                <div class="card info-card text-center py-5">
                    <h5 class="fw-bold text-black mb-4">ความสามารถ</h5>
                    <h3 class="fw-bold text-black mb-5">เขียนเว็บนี้ขึ้นมา</h3>
                    
                    <h5 class="fw-bold text-black mt-4">คำคมบาดใจกางเกงขาดตูด</h5>
                </div>

            </div>
        </div>

        <!-- รูปภาพผู้ดูแลระบบด้านขวา (เรียกใช้ Administrator.jpg) -->
        <img src="/images/Administrator.jpg" alt="Admin Figure" class="admin-hero-img">
        
    </div>

</body>
</html>