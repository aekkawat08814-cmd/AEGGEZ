<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        .image-placeholder {
            height: 200px;
            background-color: #e9ecef;
            border: 2px dashed #ced4da;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #6c757d;
            cursor: pointer;
            transition: 0.3s;
        }
        .image-placeholder:hover {
            background-color: #f8f9fa;
            border-color: #114e9e;
            color: #114e9e;
        }
    </style>
</head>
<body class="d-flex bg-light">
    
    <%- include('partials/navbar') %>

    <div class="p-5 flex-grow-1">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">รูปภาพการแข่งขัน</h3>
                <p class="text-muted small">พื้นที่สำหรับใส่ภาพบรรยากาศการแข่งขัน (สามารถแก้ไขและนำภาพจริงมาใส่ได้ภายหลัง)</p>
            </div>
            <button class="btn btn-primary" style="background-color: #114e9e; border: none;">
                <i class="bi bi-upload"></i> อัปโหลดรูปภาพ
            </button>
        </div>

        <div class="row g-4 mt-2">
            <!-- ช่องเว้นว่างสำหรับรูปที่ 1 -->
            <div class="col-md-4 col-lg-3">
                <div class="image-placeholder">
                    <i class="bi bi-image fs-1 mb-2"></i>
                    <span>ยังไม่มีรูปภาพ</span>
                </div>
            </div>
            <!-- ช่องเว้นว่างสำหรับรูปที่ 2 -->
            <div class="col-md-4 col-lg-3">
                <div class="image-placeholder">
                    <i class="bi bi-image fs-1 mb-2"></i>
                    <span>ยังไม่มีรูปภาพ</span>
                </div>
            </div>
            <!-- ช่องเว้นว่างสำหรับรูปที่ 3 -->
            <div class="col-md-4 col-lg-3">
                <div class="image-placeholder">
                    <i class="bi bi-plus-circle fs-1 mb-2"></i>
                    <span>เพิ่มรูปภาพใหม่</span>
                </div>
            </div>
        </div>
    </div>
</body>
</html>