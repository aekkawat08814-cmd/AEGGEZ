<div class="d-flex flex-column flex-shrink-0 p-3" style="width: 260px; min-height: 100vh; background-color: #0a192f;">
    
    <a href="/" class="d-flex align-items-center mb-4 me-md-auto text-decoration-none px-2 mt-2">
        <!-- แสดงรูป Logo วิทยาลัยเทคนิคภูเก็ต -->
        <img src="/images/Logo.jpg" alt="Logo" width="45" class="me-3 rounded-circle bg-white p-1">
        <div>
            <span class="fs-6 fw-bold d-block text-white" style="line-height: 1.2;">COMPETITION</span>
            <span style="font-size: 0.65rem; color: #8ba1ba; letter-spacing: 0.5px;">IT SKILL SYSTEM</span>
        </div>
    </a>
    
    <style>
        .nav-custom-link { color: #8ba1ba; border-radius: 8px; transition: all 0.2s; padding: 12px 15px; font-size: 0.9rem; }
        .nav-custom-link:hover { color: #ffffff; background-color: rgba(255,255,255,0.05); }
        
        /* เปลี่ยนสีพื้นหลัง Active ให้เป็นสีฟ้าสว่างแบบในรูป */
        .nav-custom-link.active { color: #ffffff; background-color: #0d6efd; font-weight: 500; }
        
        .nav-custom-link i { width: 20px; text-align: center; margin-right: 12px; font-size: 1.1rem; }
    </style>
    
    <ul class="nav nav-pills flex-column mb-auto gap-1">
        
        <!-- 1. หน้าหลัก -->
        <li class="nav-item">
            <a href="/" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>">
                <i class="bi bi-house"></i> หน้าหลัก
            </a>
        </li>
        
        <!-- 2. ผู้ลงทะเบียน -->
        <li class="nav-item">
            <a href="/registrants" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'registrants' ? 'active' : '' %>">
                <i class="bi bi-person-fill"></i> ผู้ลงทะเบียน
            </a>
        </li>

        <!-- 3. รายชื่อคณะกรรมการ -->
        <li class="nav-item">
            <a href="/committees" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'committees' ? 'active' : '' %>">
                <i class="bi bi-person-vcard"></i> รายชื่อคณะกรรมการ
            </a>
        </li>

        <!-- 4. กฎกติกา -->
        <li class="nav-item">
            <a href="/rules" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'rules' ? 'active' : '' %>">
                <i class="bi bi-file-earmark-text"></i> กฎกติกา
            </a>
        </li>

        <!-- 5. รูปภาพการแข่งขัน -->
        <li class="nav-item">
            <a href="/gallery" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'gallery' ? 'active' : '' %>">
                <i class="bi bi-images"></i> รูปภาพการแข่งขัน
            </a>
        </li>

        <!-- 6. การติดต่อ -->
        <li class="nav-item">
            <a href="/contact" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'contact' ? 'active' : '' %>">
                <i class="bi bi-telephone"></i> การติดต่อ
            </a>
        </li>

        <!-- 7. ประกาศผลการแข่งขัน -->
        <li class="nav-item">
            <a href="/results" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'results' ? 'active' : '' %>">
                <i class="bi bi-bar-chart"></i> ประกาศผลการแข่งขัน
            </a>
        </li>

        <!-- 8. ประกาศข่าวสาร -->
        <li class="nav-item">
            <a href="/news" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'news' ? 'active' : '' %>">
                <i class="bi bi-newspaper"></i> ประกาศข่าวสาร
            </a>
        </li>

        <!-- 9. ข้อมูลสถานศึกษา -->
        <li class="nav-item">
            <a href="/college-info" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'college-info' ? 'active' : '' %>">
                <i class="bi bi-building"></i> ข้อมูลสถานศึกษา
            </a>
        </li>

        <!-- 10. ผู้ดูแลระบบ -->
        <li class="nav-item mt-4 pt-4 border-top" style="border-color: rgba(255,255,255,0.1) !important;">
            <a href="/admin" class="nav-link nav-custom-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'admin' ? 'active' : '' %>">
                <i class="bi bi-person-badge"></i> ผู้ดูแลระบบ
            </a>
        </li>
    </ul>
</div>