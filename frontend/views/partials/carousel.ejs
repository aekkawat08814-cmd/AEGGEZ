<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex bg-light">
    <%- include('partials/navbar') %>
    <div class="p-5 flex-grow-1">
        <h3 class="fw-bold mb-4">การติดต่อ</h3>
        <div class="card border-0 shadow-sm p-4 w-50">
            <p><strong>สถานที่:</strong> <%= data.location %></p>
            <p><strong>เบอร์ติดต่อ:</strong> <%= data.phone %></p>
            <p><strong>วันที่จัดแข่ง:</strong> <%= data.date %></p>
            <p><strong>เวลา:</strong> <%= data.time %></p>
            <button class="btn btn-warning mt-3" data-bs-toggle="modal" data-bs-target="#editContact">แก้ไขข้อมูล</button>
        </div>
    </div>

    <!-- Modal แก้ไขข้อมูล -->
    <div class="modal fade" id="editContact" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/edit-contact" method="POST">
                    <div class="modal-body">
                        <label>สถานที่</label><input type="text" name="location" class="form-control mb-2" value="<%= data.location %>">
                        <label>เบอร์ติดต่อ</label><input type="text" name="phone" class="form-control mb-2" value="<%= data.phone %>">
                        <label>วันที่</label><input type="text" name="date" class="form-control mb-2" value="<%= data.date %>">
                        <label>เวลา</label><input type="text" name="time" class="form-control mb-2" value="<%= data.time %>">
                    </div>
                    <div class="modal-footer"><button type="submit" class="btn btn-primary">บันทึก</button></div>
                </form>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>