<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- เรียกใช้ Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- บรรทัดนี้คือตัวแก้ปัญหาไอคอนหายครับ -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- เรียกใช้ Chart.js สำหรับทำกราฟ -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .content-wrapper { padding: 40px; }
        .card-custom { border-radius: 8px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    </style>
</head>
<body class="d-flex">

    <!-- ดึง Sidebar -->
    <%- include('partials/navbar') %>

    <div class="content-wrapper flex-grow-1">
        
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h6 class="text-uppercase fw-bold text-muted mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">RESULTS</h6>
                <h3 class="fw-bold text-dark mb-1">ประกาศผลการแข่งขัน</h3>
                <p class="text-muted small">สรุปคะแนนการพัฒนาระบบประเมินบุคลากร</p>
            </div>
        </div>

        <!-- กราฟแสดงผลคะแนน -->
        <div class="card card-custom p-4 w-100" style="max-width: 800px;">
            <canvas id="scoreChart" height="120"></canvas>
        </div>

    </div>

    <!-- Script สร้างกราฟแท่ง -->
    <script>
        const ctx = document.getElementById('scoreChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['ทีมเทคโนโลยีสารสนเทศ 1', 'ทีมคอมพิวเตอร์โปรแกรมเมอร์ 1', 'ทีมเทคโนโลยีสารสนเทศ 2', 'ทีมคอมพิวเตอร์โปรแกรมเมอร์ 2'],
                datasets: [{
                    label: 'คะแนนรวม (เต็ม 100)',
                    data: [85, 92, 78, 88],
                    backgroundColor: [
                        '#0d6efd', /* สีฟ้า */
                        '#198754', /* สีเขียว */
                        '#ffc107', /* สีเหลือง */
                        '#dc3545'  /* สีแดง */
                    ],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false } // ซ่อนป้ายกำกับด้านบน
                },
                scales: {
                    y: { beginAtZero: true, max: 100 } // ให้คะแนนเริ่มที่ 0 สูงสุด 100
                }
            }
        });
    </script>

    <!-- Script สำหรับ Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>