<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- เรียกใช้ Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .content-wrapper { padding: 40px; }
        .card-custom { border-radius: 8px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        
        /* ตั้งค่าให้รูปภาพในสไลด์มีขนาดคงที่และไม่ผิดสัดส่วน */
        .carousel-inner img { 
            border-radius: 8px; 
            height: 320px; /* ปรับความสูงให้สมดุลกับฝั่งขวา */
            object-fit: cover; 
        }
        
        /* ตกแต่งกรอบแผนที่ Google Maps */
        .map-container {
            border-radius: 8px;
            overflow: hidden;
            height: 100%;
            min-height: 400px;
            border: 1px solid #e9ecef;
        }
    </style>
</head>
<body class="d-flex">

    <!-- ดึง Sidebar -->
    <%- include('partials/navbar') %>

    <div class="content-wrapper flex-grow-1">
        <h3 class="fw-bold mb-4">การติดต่อ</h3>

        <div class="row g-4">
            
            <!-- ฝั่งซ้าย: ข้อมูล + รูปภาพสไลด์ -->
            <div class="col-lg-6 d-flex flex-column">
                
                <!-- 1. การ์ดข้อมูลการติดต่อ -->
                <div class="card card-custom p-4 mb-4">
                    <p class="mb-2 small"><strong>สถานที่:</strong> <%= data.location %></p>
                    <p class="mb-2 small"><strong>เบอร์ติดต่อ:</strong> <%= data.phone %></p>
                    <p class="mb-2 small"><strong>วันที่จัดแข่ง:</strong> <%= data.date %></p>
                    <p class="mb-4 small"><strong>เวลา:</strong> <%= data.time %></p>
                    <button class="btn w-100 fw-bold shadow-sm" style="background-color: #ffc107; color: #000;" data-bs-toggle="modal" data-bs-target="#editContact">
                        แก้ไขข้อมูล
                    </button>
                </div>

                <!-- 2. สไลด์รูปภาพวิทยาลัย (ใช้ภาพ contact1.jpg และ contact2.jpg) -->
                <div class="card card-custom p-1 bg-white shadow-sm border-0">
                    <div id="contactCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner" style="border-radius: 8px;">
                            
                            <!-- รูปภาพที่ 1 -->
                            <div class="carousel-item active">
                                <img src="/images/contact1.jpg" class="d-block w-100" alt="บรรยากาศวิทยาลัย 1">
                            </div>
                            
                            <!-- รูปภาพที่ 2 -->
                            <div class="carousel-item">
                                <img src="/images/contact2.jpg" class="d-block w-100" alt="บรรยากาศวิทยาลัย 2">
                            </div>

                        </div>
                        
                        <!-- ปุ่มเลื่อนซ้าย-ขวา -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#contactCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-dark rounded-circle p-2 opacity-75" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#contactCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-dark rounded-circle p-2 opacity-75" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>

            </div>

            <!-- ฝั่งขวา: แผนที่ Google Maps แบบรูปภาพเป้าหมาย -->
            <div class="col-lg-6">
                <div class="card card-custom p-4 h-100 d-flex flex-column bg-white shadow-sm border-0">
                    <h5 class="fw-bold mb-3" style="color: #1a237e;">สถานที่ตั้ง (แผนที่)</h5>
                    
                    <div class="map-container flex-grow-1">
                        <!-- โค้ด iframe Google Maps วิทยาลัยเทคนิคภูเก็ต -->
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15808.647319760773!2d98.37525336040854!3d7.881260334796349!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x305031fd2a640103%3A0xc3f146be48b783c!2z4Lin4Li04LiX4Lii4Liy4Lil4Lix4Lii4LmA4LiX4LiE4LiZ4Li04LiE4Lig4Li54LmA4LiB4LmH4LiV!5e0!3m2!1sth!2sth!4v1700000000000!5m2!1sth!2sth" 
                            width="100%" 
                            height="100%" 
                            style="border:0;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Modal: แก้ไขข้อมูลการติดต่อ -->
    <div class="modal fade" id="editContact" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0 mt-2 mx-2">
                    <h5 class="modal-title fw-bold">แก้ไขข้อมูลการติดต่อ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/edit-contact" method="POST">
                    <div class="modal-body p-4">
                        <label class="small fw-bold text-muted">สถานที่</label>
                        <input type="text" name="location" class="form-control mb-3" value="<%= data.location %>">
                        <label class="small fw-bold text-muted">เบอร์ติดต่อ</label>
                        <input type="text" name="phone" class="form-control mb-3" value="<%= data.phone %>">
                        <label class="small fw-bold text-muted">วันที่จัดแข่ง</label>
                        <input type="text" name="date" class="form-control mb-3" value="<%= data.date %>">
                        <label class="small fw-bold text-muted">เวลา</label>
                        <input type="text" name="time" class="form-control mb-3" value="<%= data.time %>">
                    </div>
                    <div class="modal-footer border-0 pb-4 pe-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
                        <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">บันทึกข้อมูล</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Script สำหรับ Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>