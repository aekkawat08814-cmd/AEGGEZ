<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- เรียกใช้ Bootstrap 5 และ Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        body { 
            background-color: #f4f6f9; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
        }
        .content-wrapper { padding: 40px; }
        .card-custom { 
            border-radius: 12px; 
            border: none; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.03); 
        }
        .search-bar { 
            border-radius: 8px; 
            padding: 10px 15px 10px 40px; 
            border: 1px solid #dee2e6; 
            width: 350px; 
            font-size: 0.9rem;
        }
        .search-icon {
            position: absolute;
            top: 12px;
            left: 15px;
            color: #adb5bd;
        }
        .count-badge { 
            background-color: #e0f2fe; 
            color: #0369a1; 
            font-weight: 600; 
            border-radius: 20px; 
            padding: 5px 15px; 
            font-size: 0.85rem;
        }
        .table-header { color: #6c757d; font-size: 0.8rem; font-weight: 600; }
        .table tbody td { padding: 18px 10px; vertical-align: middle; font-size: 0.9rem; color: #495057; }
    </style>
</head>
<body class="d-flex">

    <!-- ดึง Navbar แบบ Sidebar มาแสดง -->
    <%- include('partials/navbar') %>

    <!-- พื้นที่เนื้อหาหลัก -->
    <div class="content-wrapper flex-grow-1">
        
        <!-- ส่วน Header ของหน้า -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h6 class="text-primary fw-bold mb-1 text-uppercase" style="letter-spacing: 1.5px; font-size: 0.75rem;">Registrants</h6>
                <h3 class="fw-bold text-dark mb-1">ผู้ลงทะเบียน</h3>
                <p class="text-muted small">ข้อมูลที่บันทึกจะแสดงเป็นรายชื่อบนหน้าเว็บทันที</p>
            </div>
            
            <!-- ปุ่มเพิ่มผู้ลงทะเบียน จะลิงก์กลับไปที่หน้าแรก (/) -->
            <a href="/" class="btn btn-primary fw-bold shadow-sm" style="border-radius: 8px; padding: 10px 20px; background-color: #114e9e; border: none;">
                + เพิ่มผู้ลงทะเบียน
            </a>
        </div>

        <!-- การ์ดตารางข้อมูล -->
        <div class="card card-custom p-4">
            
            <!-- ช่องค้นหา และ แบดจ์นับจำนวน -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="position-relative">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="form-control search-bar" placeholder="ค้นหาชื่อ / เลขประจำตัว / แผนก">
                </div>
                <div class="count-badge">
                    <%= data.length %> คน
                </div>
            </div>

            <!-- ส่วนตาราง -->
            <div class="table-responsive">
                <table class="table table-borderless align-middle text-center mb-0">
                    <thead class="border-bottom table-header">
                        <tr>
                            <th class="text-start pb-3" style="width: 5%;">#</th>
                            <th class="text-start pb-3" style="width: 25%;">ชื่อ - นามสกุล</th>
                            <th class="pb-3" style="width: 20%;">เลขประจำตัว</th>
                            <th class="pb-3" style="width: 20%;">อีเมล</th>
                            <th class="pb-3" style="width: 20%;">แผนก</th>
                            <th class="pb-3" style="width: 10%;">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- ใช้ EJS วนลูปแสดงข้อมูลจากตัวแปร data -->
                        <% if (data && data.length > 0) { %>
                            <% data.forEach((item, index) => { %>
                                <tr class="border-bottom">
                                    <td class="text-start"><%= index + 1 %></td>
                                    <td class="text-start fw-bold text-dark"><%= item.fullname %></td>
                                    <td><%= item.studentId %></td>
                                    <td><%= item.email %></td>
                                    <td><%= item.department %></td>
                                    <td>
                                        <button class="btn btn-sm btn-light rounded-pill px-3" style="font-size: 0.8rem; color: #6c757d; border: 1px solid #dee2e6;">แก้ไข</button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <!-- กรณีที่ยังไม่มีข้อมูล -->
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    ยังไม่มีผู้ลงทะเบียน
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            
        </div>
    </div>

</body>
</html>